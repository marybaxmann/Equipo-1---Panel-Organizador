            "method": "PATCH",
            "url": "{{baseUrl}}/panel/eventos/mios/{{nuevoEventoId}}",
            "description": "Caso: Como Org B · sin cookie · cuerpo vacío / Resultado esperado: 403 · 401 · 400",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "jwt=token-org-b"
