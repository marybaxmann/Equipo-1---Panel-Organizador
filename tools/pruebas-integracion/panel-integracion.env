# Variables para docker-compose.integracion.yml del Panel en la sesion de integracion (se usa con --env-file, asi no se
# lee el .env de desarrollo, que apunta a localhost). La clave de Auth NO va aqui: se toma de AUTH_INTERNAL_API_KEY.
# SEED_DEMO=true BORRA los eventos y carga el seed, y lo anuncia por el broker para que Entradas lo conozca.
SEED_DEMO=true
