# Base de la API del Panel. En desarrollo pasa por el proxy de Vite (vite.config.js).
# En integración: la URL del API Gateway, p. ej. https://gateway.ticketu.cl/api/v1/panel
VITE_API_BASE_URL=/api/v1/panel

# Login. En desarrollo: el login simulado de este frontend. En integración: la URL del login de Auth.
VITE_AUTH_LOGIN_URL=/login
