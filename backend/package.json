{
  "name": "@panel/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:report": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=../docs/evidencias/pruebas-funcionalidad/vitest-junit.xml --coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongoose": "^9.10.3",
    "swagger-ui-express": "^5",
    "yaml": "^2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@panel/database": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^6",
    "@types/swagger-ui-express": "^4",
    "@vitest/coverage-v8": "^3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^10",
    "supertest": "^7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3"
  }
}
