# Base de la API del Panel. En desarrollo pasa por el proxy de Vite (vite.config.js) que apunta al Gateway (:8080).
# El Gateway enruta /api/organizador/* al microservicio panel-organizador.
VITE_API_BASE_URL=/api/organizador/v1/panel

# Login. En desarrollo: el login simulado de este frontend. En integración: la URL del login de Auth.
VITE_AUTH_LOGIN_URL=/login
