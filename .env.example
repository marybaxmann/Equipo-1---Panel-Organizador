# .env.example — copiar a .env
PORT=3000
MONGO_URI=mongodb://localhost:27017/panel_organizador
AUTH_SERVICE_URL=http://localhost:4001
AUTH_TIMEOUT_MS=1000
CORS_ORIGIN=http://localhost:5173
# Tópicos del broker (INT-02). Son propuestas de Panel pendientes de acuerdo: si cambian, se cambian aquí, no en el código
TOPIC_CATALOGO=panel.evento.catalogo.v1
TOPIC_ENTRADAS=panel.evento.entradas.v1
TOPIC_NOTIFICACIONES=panel.evento.notificaciones.v1
TOPIC_CHECKIN=panel.evento.checkin.v1
TOPIC_PROMOCIONES=panel.evento.promociones.v1
# Broker de eventos de la plataforma TicketU (RabbitMQ compartido, exchange de tipo topic).
# Sin BROKER_URL la API funciona igual: los mensajes quedan PENDIENTE en mensajes_salientes.
# Desde el host: localhost; desde Docker: ticketu-rabbitmq (ver docker-compose.integracion.yml)
# BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu
EVENT_EXCHANGE=ticketu.events
