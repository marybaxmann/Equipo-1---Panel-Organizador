    {
      "name": "01 Auth (servicio consumido)",
      "item": [
        {
          "name": "Caso: Auth directo: token organizador / Resultado esperado: 200, valido=true",
          "request": {
            "method": "GET",
            "url": "{{authUrl}}/validar-sesion",
            "description": "Caso: Auth directo: token organizador / Resultado esperado: 200, valido=true",
            "header": [
              {
                "key": "Cookie",
                "value": "jwt=token-org-a"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es válido y organizador\", () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.valido).to.be.true;",
                  "    pm.expect(data.usuario.rol).to.eql(\"organizador\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Caso: Auth directo: token expirado / Resultado esperado: 401",
