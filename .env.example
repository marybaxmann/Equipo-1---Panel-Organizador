# .env.example — copiar a .env
PORT=3000
MONGO_URI=mongodb://localhost:27017/panel_organizador
AUTH_SERVICE_URL=http://localhost:4001
AUTH_TIMEOUT_MS=1000
# Contrato Auth v1.1 §6: sin reintentos automáticos por defecto (0). Sólo ante timeout, error de red o 503
AUTH_REINTENTOS=0
# Clave compartida que Auth exige en la cabecera x-api-key (contrato Auth v1.1, INT-11).
# Pedirla al equipo de Auth por privado; nunca se sube al repo. Con el mock es opcional:
# si se define aquí, el mock también la exige (docker-compose.yml).
# AUTH_INTERNAL_API_KEY=
# Orígenes permitidos separados por coma: frontend propio (Vite) y Frontend Unificado de TicketU
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Entradas / Inventario: consulta de stock antes de eliminar un evento publicado (HU-03).
# En local apunta al mock (tools/mock-entradas); sin esta variable, eliminar un PUBLICADO responde 503.
ENTRADAS_SERVICE_URL=http://localhost:4002
ENTRADAS_TIMEOUT_MS=1000
# Tópicos del broker (INT-02). Son propuestas de Panel pendientes de acuerdo: si cambian, se cambian aquí, no en el código
TOPIC_CATALOGO=panel.evento.catalogo.v1
TOPIC_ENTRADAS=panel.evento.entradas.v1
TOPIC_NOTIFICACIONES=panel.evento.notificaciones.v1
TOPIC_CHECKIN=panel.evento.checkin.v1
TOPIC_PROMOCIONES=panel.evento.promociones.v1
# Broker de eventos de la plataforma TicketU (RabbitMQ compartido, exchange de tipo topic).
# Sin BROKER_URL la API funciona igual: los mensajes quedan PENDIENTE en mensajes_salientes.
# Desde el host: localhost; desde Docker: ticketu-rabbitmq (ver docker-compose.integracion.yml)
# BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu
EVENT_EXCHANGE=ticketu.events
# Tópicos cuyo consumidor lee el sobre dentro del cuerpo { envelope, payload } (ADR-0017). Entradas lo necesita
BROKER_TOPICOS_CON_SOBRE=panel.evento.entradas.v1
# Exchange adicional por tópico, "topico=exchange" (ADR-0019). El contrato de Notificaciones fija su propio exchange:
# sus mensajes salen en ticketu.events y también en panel.evento.notificaciones.v1, con la misma routing key
BROKER_EXCHANGES_ADICIONALES=panel.evento.notificaciones.v1=panel.evento.notificaciones.v1
# Lo que Panel recibe de Entradas: aviso de stock = 0 → evento AGOTADO (contrato Entradas §3.4, ADR-0018).
# Sólo se escucha si hay BROKER_URL. La cola es durable y propia del Panel
TOPIC_STOCK_ENTRADAS=entradas.evento.stock.v1
BROKER_COLA_STOCK=panel-organizador.entradas.stock
